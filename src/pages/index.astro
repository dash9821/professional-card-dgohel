<!-- You can replace the card's data with your own here. -->
<BaseLayout title="Darshan Gohel Personal Card" description="Meta description. Here goes your page description. Provide a clear and concise summary of the content.">
	<Card
	  name="Darshan Gohel"
	  position="DevOps Engineer"
	  aboutMe={`DevOps & Platform Engineer with a proven track record of optimizing cloud and on-prem infrastructure.\n\nSpecialized in IaC (Terraform, Terragrunt), robust CI/CD pipelines, and Kubernetes orchestration. I bridge the gap between development and operations by building scalable frameworks, automating security pipelines, and enhancing deployment reliability. Driven by high availability, GitOps compliance, and seamless developer workflows.`}
	  linkedin="https://www.linkedin.com/in/darshan-gohel-devops"
	  github="https://github.com/dash9821"
	  cvLink="/files/Darshan-Gohel-Resume-1.pdf"
	  profileImage="/images/Darshan-Gohel-Photo-Suit.webp"
	/>
</BaseLayout>

